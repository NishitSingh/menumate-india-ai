# Copy to .env.local for local development (never commit .env.local).
# You need at least ONE of the two keys. With both, Gemini is tried first and
# Groq takes over automatically when Gemini is busy or out of free quota.

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model with image input and free quota (see https://ai.dev/rate-limit)
GEMINI_MODEL=gemini-3.8-flash

# Groq (backup) — free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Must be a Groq model with image input (see https://console.groq.com/docs/vision)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: change the order, e.g. "groq,gemini" to try Groq first.
# AI_PROVIDER_ORDER=gemini,groq

# IMPORTANT: never prefix these with VITE_ — that would bundle the keys into the browser code.
